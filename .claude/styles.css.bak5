/* ==========================================================================
   Phnom Penh Restaurant
   Every value here is recorded in DESIGN.md sections 2 through 5.
   Nothing is styled anywhere else. No inline styles, no <style> blocks.

   1.  Tokens
   2.  Base and resets
   3.  Container
   4.  Eyebrow
   5.  Buttons
   6.  Utility bar          RESERVED
   7.  Header and nav
   8.  Mobile menu
   9.  Hero
   10. Reveal animation
   11. Ticker               RESERVED
   12. Story                RESERVED
   13. Icons rail           RESERVED
   14. Feature              RESERVED
   15. Visit two-up         RESERVED, and superseded below by section 23
   16. Footer               superseded below by section 24
   17. Responsive, upper
   18. Michelin recognition
   19. Legacy
   20. Menu                 RESERVED
   21. Popular dishes
   22. News and reviews
   23. Visit
   24. Footer
   25. Responsive, lower

   RESERVED means no page uses it yet. These are the parts bin for story.html,
   menu.html and visit.html, about 8KB in total. They are kept on purpose, not
   by accident. Once those three pages are built, delete whatever is still
   unused. See DESIGN.md section 11.

   Sections 15 and 16 stay where they are, in this order, because 23 and 24
   override them. Moving or merging the pairs changes what renders.
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Tokens                                              DESIGN.md 2
   -------------------------------------------------------------------------- */
:root{
  --ink:#0F0C0B;                        /* page ground, darkest */
  --ink-2:#17110E;                      /* second dark ground, legacy and footer */
  --ink-3:#1F1814;                      /* third dark ground, panels */
  --paper:#F3E9DB;                      /* warm cream, text on dark grounds */
  --surface:#FBF9F4;                    /* near white, the two light section grounds */
  --paper-dim:rgba(243,233,219,.66);    /* secondary text on dark */
  --paper-faint:rgba(243,233,219,.40);  /* tertiary text on dark */
  --red:#C5302A;                        /* accent, prices, rules, dots, nav underline */
  --red-deep:#9E241F;                   /* dark stop of red gradients */
  --gold:#BF9C5C;                       /* button borders, eyebrows, labels */
  --line:rgba(243,233,219,.14);         /* hairline on dark */
  --line-strong:rgba(243,233,219,.26);  /* hairline on dark, hover */
  --maxw:1240px;                        /* content container */
  --ease:cubic-bezier(.22,.61,.36,1);
}

/* --------------------------------------------------------------------------
   2. Base and resets
   -------------------------------------------------------------------------- */
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--ink);color:var(--paper);
  font-family:"Montserrat",system-ui,sans-serif;
  font-size:16.5px;line-height:1.65;letter-spacing:.01em;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
h1,h2,h3{font-family:"Montserrat",sans-serif;font-weight:300;
  line-height:1.1;letter-spacing:.005em;margin:0;}

/* Section heading. One size for every section on every page, DESIGN.md 3.
   The colour and the max-width stay with each section. */
.mich-h2,.legacy-h2,.pop-head h2,.news-head h2,.visit-head h2{
  font-size:clamp(2rem,4.6vw,3.3rem)}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
::selection{background:var(--red);color:var(--paper)}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:2px}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px}

.eyebrow{font-size:12px;font-weight:600;letter-spacing:.26em;text-transform:uppercase;
  color:var(--gold);display:inline-flex;align-items:center;gap:.6em;}
.eyebrow::before{content:"";width:26px;height:1px;background:var(--gold);opacity:.7}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6em;font-weight:500;font-size:12.5px;
  letter-spacing:.2em;text-transform:uppercase;padding:19px 42px;border-radius:0;
  border:1.5px solid var(--gold);background:transparent;color:#F6F1E9;
  transition:background .35s var(--ease),color .35s var(--ease),border-color .35s var(--ease);cursor:pointer;white-space:nowrap}
.btn-red{background:transparent;color:#F6F1E9;border:1.5px solid var(--gold)}
.btn-red:hover{background:var(--gold);color:#171310;border-color:var(--gold)}
.btn-ghost{border-color:var(--gold);color:#F6F1E9}
.btn-ghost:hover{background:var(--gold);color:#171310;border-color:var(--gold)}
.btn .ar{transition:transform .3s var(--ease)}
.btn:hover .ar{transform:translateX(4px)}

/* ---------- utility bar ---------- */
.util{background:linear-gradient(180deg,#CD342D 0%,#B02A24 55%,var(--red-deep) 100%);color:var(--paper);box-shadow:inset 0 -1px 0 rgba(0,0,0,.22);font-size:12px;letter-spacing:.14em;
  text-transform:uppercase;font-weight:600}
.util .wrap{display:flex;justify-content:space-between;align-items:center;
  gap:16px;min-height:38px;padding-top:8px;padding-bottom:8px}
.util .star{color:var(--gold)}
.util a{display:inline-flex;align-items:center;gap:.5em;transition:opacity .25s}
.util a:hover{opacity:.78}
.util .util-r .ar{transition:transform .25s var(--ease)}
.util a:hover .ar{transform:translateX(3px)}

/* ---------- header ---------- */
/* The slot the header partial replaces. 80px is the nav height, so the page
   lays out identically before and after the swap and nothing jumps. */
.head-slot{height:80px}
.site-head{position:sticky;top:0;z-index:60;transition:background .4s var(--ease),border-color .4s}
.site-head::after{content:"";position:absolute;inset:0;background:linear-gradient(var(--ink),rgba(15,12,11,0));
  opacity:1;transition:opacity .4s;z-index:-1;pointer-events:none}
.site-head.solid{background:rgba(15,12,11,.92);backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line)}
.site-head.solid::after{opacity:0}
.nav{position:relative;display:flex;align-items:center;min-height:80px}
.nav-link{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--paper-dim);position:relative;padding:6px 0;transition:color .25s}
.nav-link::after{content:"";position:absolute;left:0;bottom:0;height:1.5px;width:0;
  background:var(--red);transition:width .3s var(--ease)}
.nav-link:hover{color:var(--paper)}
.nav-link:hover::after{width:100%}
.brand{flex:0 0 auto}
.nav-links{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;gap:32px}
.brand img{height:30px;width:auto}
.nav-cta{margin-left:auto;flex:0 0 auto}
.burger{display:none;background:none;border:0;color:var(--paper);cursor:pointer;
  width:42px;height:42px;align-items:center;justify-content:center}
.burger span{display:block;width:22px;height:2px;background:var(--paper);position:relative}
.burger span::before,.burger span::after{content:"";position:absolute;left:0;width:22px;height:2px;background:var(--paper);transition:.3s}
.burger span::before{top:-7px}.burger span::after{top:7px}

.mobile-menu{position:fixed;inset:0;z-index:55;background:var(--ink);
  display:flex;flex-direction:column;justify-content:center;gap:8px;padding:32px;
  transform:translateY(-100%);transition:transform .45s var(--ease);visibility:hidden}
.mobile-menu.open{transform:translateY(0);visibility:visible}
.mobile-menu a{font-family:"Montserrat",sans-serif;font-weight:300;font-size:28px;letter-spacing:.01em;
  color:var(--paper);padding:17px 0;border-bottom:1px solid var(--line)}
.mobile-menu a:last-child{border:0}
.mm-close{position:absolute;top:22px;right:22px;font-size:34px;background:none;border:0;color:var(--paper);cursor:pointer;line-height:1}

/* ---------- hero ---------- */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;
  overflow:hidden;margin-top:-80px;padding-top:80px}
.hero-bg{position:absolute;inset:0;
  background-image:url('../images/hero-chicken-wings.jpg');
  background-image:image-set(url('../images/hero-chicken-wings.webp') type('image/webp'),url('../images/hero-chicken-wings.jpg') type('image/jpeg'));
  background-size:cover;background-position:68% 50%;transform:scale(1.08);
  animation:heroZoom 24s var(--ease) forwards;z-index:0}
@keyframes heroZoom{to{transform:scale(1)}}
.hero-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;
  background:
    linear-gradient(94deg,rgba(15,12,11,.94) 0%,rgba(15,12,11,.80) 34%,rgba(15,12,11,.18) 66%,rgba(15,12,11,.34) 100%),
    linear-gradient(0deg,rgba(15,12,11,.94) 2%,rgba(15,12,11,.30) 45%,rgba(15,12,11,0) 78%);}
/* Centred, then nudged just below the optical centre. The nudge is capped so
   it stays a nudge on a tall monitor, and it is small enough that the block
   never overflows a short window. Replaces align-items:flex-end, which pinned
   the block to the floor and left up to 57 percent of the hero empty above it
   on a tall screen. DESIGN.md 5. */
.hero-inner{position:relative;z-index:2;width:100%;padding-top:calc(60px + min(6svh, 56px));padding-bottom:74px}
.hero h1{font-size:clamp(2.7rem,7vw,5.6rem);max-width:17ch;line-height:1.06;letter-spacing:.008em}
.hero h1 .amp{font-weight:300;font-style:italic;color:var(--gold)}
.hero-sub{margin:26px 0 34px;max-width:46ch;font-size:clamp(1.05rem,1.6vw,1.35rem);
  color:var(--paper-dim);line-height:1.55}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px}
.scroll-cue{position:absolute;right:30px;bottom:30px;z-index:2;font-size:11px;
  letter-spacing:.24em;text-transform:uppercase;color:var(--paper-faint);
  writing-mode:vertical-rl;display:flex;align-items:center;gap:14px}
.scroll-cue::after{content:"";width:1px;height:54px;background:linear-gradient(var(--paper-faint),transparent);
  animation:cue 2.2s var(--ease) infinite}
@keyframes cue{0%{transform:scaleY(.2);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}50.1%{transform-origin:bottom}100%{transform:scaleY(.2);transform-origin:bottom}}

.reveal{opacity:0;transform:translateY(26px);transition:opacity .9s var(--ease),transform .9s var(--ease)}
.reveal.in{opacity:1;transform:none}
.d1{transition-delay:.08s}.d2{transition-delay:.18s}.d3{transition-delay:.28s}.d4{transition-delay:.38s}

/* ---------- ticker (signature) ---------- */
.ticker{background:linear-gradient(180deg,#CB332C 0%,#B92D27 40%,var(--red-deep) 100%);color:var(--paper);border-top:1px solid rgba(0,0,0,.18);
  border-bottom:1px solid rgba(0,0,0,.22);box-shadow:inset 0 10px 22px -14px rgba(0,0,0,.55),inset 0 -10px 22px -14px rgba(0,0,0,.55);padding:22px 0;overflow:hidden}
.ticker-track{display:flex;width:max-content;animation:marquee 38s linear infinite}
.ticker:hover .ticker-track{animation-play-state:paused}
.ticker-seg{display:flex;align-items:center}
.ticker-item{font-weight:700;
  font-size:clamp(1.5rem,3.4vw,2.5rem);letter-spacing:-.01em;
  text-transform:uppercase;padding:0 .55em;white-space:nowrap}
.ticker-star{color:var(--gold);font-size:clamp(1rem,2vw,1.5rem);padding:0 .15em}
@keyframes marquee{to{transform:translateX(-50%)}}

/* ---------- story (cream) ---------- */
.story{background:var(--surface);color:var(--ink);padding:104px 0}
.story-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:start}
.story h2{font-size:clamp(2.2rem,5vw,3.9rem);color:var(--ink);max-width:14ch;margin-top:16px}
.story .eyebrow{color:var(--red)}
.story .eyebrow::before{background:var(--red)}
.story p{color:rgba(15,12,11,.74);margin:0 0 18px;max-width:52ch}
.story p:first-of-type{margin-top:4px}
.badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}
.badge{font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  border:1px solid rgba(15,12,11,.18);border-radius:999px;padding:9px 15px;color:rgba(15,12,11,.7)}
.badge b{color:var(--red)}
.story-logo{margin-top:42px;padding-top:34px;border-top:1px solid rgba(15,12,11,.14)}
.story-logo img{width:min(360px,80%)}
.story-logo span{display:block;margin-top:14px;font-size:13px;letter-spacing:.16em;
  text-transform:uppercase;color:rgba(15,12,11,.5)}

/* ---------- icons rail ---------- */
.rail-sec{padding:104px 0 110px;background:var(--ink)}
.rail-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:42px}
.rail-head h2{font-size:clamp(2.1rem,5vw,3.6rem);max-width:16ch}
.rail-head .lead{color:var(--paper-dim);max-width:40ch;margin-top:14px}
.rail{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;
  padding:6px 28px 30px;margin:0 -28px;-webkit-overflow-scrolling:touch;
  scrollbar-width:thin;scrollbar-color:var(--red) transparent}
.rail::-webkit-scrollbar{height:6px}
.rail::-webkit-scrollbar-thumb{background:var(--red);border-radius:3px}
.rail::-webkit-scrollbar-track{background:var(--line)}
.card{flex:0 0 340px;scroll-snap-align:start}
.card-img{position:relative;aspect-ratio:5/4;overflow:hidden;border-radius:3px;background:var(--ink-2)}
.card-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease)}
.card:hover .card-img img{transform:scale(1.07)}
.card-tag{position:absolute;top:14px;left:14px;z-index:2;font-size:10.5px;font-weight:700;
  letter-spacing:.14em;text-transform:uppercase;background:var(--ink);color:var(--gold);
  padding:6px 11px;border-radius:999px;display:flex;align-items:center;gap:.4em}
.card-body{padding:18px 2px 0}
.card h3{font-size:1.18rem;font-weight:600;letter-spacing:.01em;display:flex;align-items:baseline;gap:.5em}
.card h3 .num{font-size:.8rem;color:var(--red);font-weight:700;letter-spacing:.05em}
.card p{color:var(--paper-dim);font-size:.95rem;margin:9px 0 0;line-height:1.5}
.card .underline{height:1.5px;width:34px;background:var(--red);margin-top:16px;transition:width .4s var(--ease)}
.card:hover .underline{width:100%}
.rail-hint{margin-top:6px;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--paper-faint)}

/* ---------- feature ---------- */
.feature{position:relative;min-height:78vh;display:flex;align-items:center;overflow:hidden}
.feature-bg{position:absolute;inset:0;background-position:center;background-size:cover;z-index:0}
/* No background-image on purpose. The photograph is a content choice, so the
   page that uses .feature sets it, following the pattern in .hero-bg. */
.feature-scrim{position:absolute;inset:0;z-index:1;
  background:linear-gradient(90deg,rgba(15,12,11,.92) 0%,rgba(15,12,11,.74) 40%,rgba(15,12,11,.30) 100%)}
.feature-inner{position:relative;z-index:2;padding:90px 0;max-width:640px}
.feature h2{font-size:clamp(2.2rem,5.4vw,4.1rem);margin:18px 0 0}
.feature p{color:var(--paper-dim);margin:22px 0 32px;max-width:48ch;font-size:1.1rem}

/* ---------- visit two-up ---------- */
.visit{padding:104px 0;background:var(--ink-2);border-top:1px solid var(--line)}
.visit-head{margin-bottom:46px;max-width:30ch}
.visit-head h2{margin-top:14px}  /* size comes from the shared section heading rule */
.two-up{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.panel{background:var(--ink-3);border:1px solid var(--line);border-radius:4px;
  padding:42px 40px;position:relative;overflow:hidden;transition:border-color .35s,transform .35s var(--ease)}
.panel::before{content:"";position:absolute;left:0;top:0;height:100%;width:3px;background:var(--red);
  transform:scaleY(0);transform-origin:top;transition:transform .45s var(--ease)}
.panel:hover{border-color:var(--line-strong);transform:translateY(-3px)}
.panel:hover::before{transform:scaleY(1)}
.panel h3{font-size:1.7rem;font-weight:700;margin:16px 0 14px}
.panel p{color:var(--paper-dim);margin:0 0 26px;max-width:42ch}
.panel .addr{font-weight:700;font-size:1.25rem;
  color:var(--paper);margin:0 0 6px;letter-spacing:-.01em}
/* Text link. Was scoped to .panel, which no page uses, so every .link on the
   site rendered as plain body text. Now global, DESIGN.md 5. */
.link{font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
  color:var(--gold);display:inline-flex;align-items:center;gap:.5em}
.link .ar{transition:transform .3s var(--ease)}
.link:hover .ar{transform:translateX(4px)}

/* ---------- footer ---------- */
.foot{background:var(--ink);border-top:1px solid var(--line);padding:74px 0 34px}
.foot-brand img{width:230px;height:auto;margin-bottom:18px}
.foot-brand p{color:var(--paper-faint);font-size:.92rem;max-width:30ch;margin:0}
.foot-col{display:block}
.foot-col h4{font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);
  margin:0 0 16px;font-family:"Montserrat",sans-serif;font-weight:700}
.foot-col a,.foot-col span{display:block;color:var(--paper-dim);font-size:.95rem;margin-bottom:11px;transition:color .25s}
.foot-col a:hover{color:var(--paper)}
.foot-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;
  margin-top:60px;padding-top:24px;border-top:1px solid var(--line);
  font-size:12.5px;letter-spacing:.04em;color:var(--paper-faint)}
.foot-bottom .star{color:var(--red)}

/* ---------- responsive ---------- */
@media(max-width:920px){
  .nav-links{display:none}
  .nav-cta{display:none}
  .burger{display:inline-flex;margin-left:auto}
  .story-grid{grid-template-columns:1fr;gap:36px}
  .two-up{grid-template-columns:1fr}
}
@media(max-width:560px){
  body{font-size:16px}
  .wrap{padding:0 20px}
  .util .wrap{font-size:10.5px;letter-spacing:.08em}
  .util-l span:nth-child(2){display:none}
  .hero-bg{background-position:60% 50%}
  .hero h1{font-size:clamp(2.9rem,13vw,4.4rem)}
  .scroll-cue{display:none}
  .rail-head{flex-direction:column;align-items:flex-start}
  .card{flex-basis:78vw}
  .panel{padding:32px 26px}
  .nav-cta{padding:12px 16px;font-size:12px}
}

@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
  .hero-bg{transform:scale(1)}
  .reveal{opacity:1;transform:none}
  .ticker-track{transform:none}
}

.card h3 .price{margin-left:auto;color:var(--gold);font-weight:600;font-size:1.02rem;letter-spacing:.01em}
.story-photo{margin-top:42px;padding-top:34px;border-top:1px solid rgba(15,12,11,.14)}
.story-photo img{width:min(380px,92%);border-radius:4px;display:block}
.story-photo span{display:block;margin-top:14px;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:rgba(15,12,11,.5)}

/* ---------- michelin recognition ---------- */
.mich{background:var(--surface);color:var(--ink);padding:98px 0 106px;border-top:1px solid rgba(15,12,11,.10)}
.mich-wrap{max-width:860px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center}
.mich-emblem{width:134px;height:134px;margin-bottom:30px;filter:drop-shadow(0 14px 30px rgba(166,44,38,.28))}
.mich-emblem svg{width:100%;height:100%;display:block}
.mich-eyebrow{color:var(--red);justify-content:center}
.mich-eyebrow::before{background:var(--red);opacity:.8}
.mich-h2{color:var(--ink);margin-top:14px;max-width:22ch}
.mich-tl{width:100%;max-width:720px;margin:46px auto 0}
.mich-years{display:grid;grid-template-columns:repeat(4,1fr)}
.mich-years span{font-family:"Montserrat",sans-serif;font-weight:300;font-size:2rem;color:var(--ink);letter-spacing:.02em}
.mich-track{position:relative;display:grid;grid-template-columns:repeat(4,1fr);align-items:center;margin:18px 0 16px}
.mich-track::before{content:"";position:absolute;left:12.5%;right:12.5%;top:50%;height:1px;background:rgba(15,12,11,.22)}
.mich-track .mt-dot{justify-self:center;width:9px;height:9px;border-radius:50%;background:var(--red);position:relative;z-index:1;box-shadow:0 0 0 4px var(--surface)}
/* minmax(0,1fr), not 1fr. A bare 1fr track cannot shrink below its widest
   unbreakable word, so "Inaugural" and "Gourmand" forced the four tracks to
   312px inside a 280px container and the page scrolled sideways below 353px. */
.mich-labels{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.mich-labels span{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:rgba(15,12,11,.55);padding:0 6px;line-height:1.45}
.mich-sub{color:rgba(15,12,11,.6);max-width:50ch;margin:34px auto 0;font-size:1rem;line-height:1.6}
@media(max-width:600px){
  .mich{padding:76px 0 82px}
  .mich-years span{font-size:1.45rem}
  .mich-labels span{font-size:9.5px;letter-spacing:.06em;padding:0 3px}
  .mich-track::before{left:12.5%;right:12.5%}
}

/* ---------- legacy ---------- */
.legacy{background:var(--ink-2);color:var(--paper);padding:102px 0 110px}
.legacy-head{text-align:center;max-width:660px;margin:0 auto}
.legacy-head .eyebrow{color:var(--red);justify-content:center}
.legacy-head .eyebrow::before{background:var(--red);opacity:.85}
.legacy-h2{color:var(--paper);margin-top:14px}
.legacy-lead{color:var(--paper-dim);margin:22px auto 0;max-width:54ch;font-size:1.05rem;line-height:1.66}
.legacy-collage{display:grid;grid-template-columns:1.5fr 1fr 1fr;grid-template-rows:232px 232px;gap:12px;margin:54px 0 46px}
.legacy-collage picture{display:block;width:100%;height:100%}
.legacy-collage img{width:100%;height:100%;object-fit:cover;object-position:center 22%;border-radius:3px;display:block}
.legacy-collage .lc-big{grid-column:1;grid-row:1 / 3}
.legacy-cta-wrap{text-align:center}
@media(max-width:760px){
  .legacy-collage{grid-template-columns:1fr 1fr;grid-template-rows:none;gap:8px}
  /* The <picture> is the sized box here, since .lc-* carries the aspect ratio.
     It goes height:auto so the ratio drives it, and the img keeps filling it. */
  .legacy-collage picture{height:auto}
  .legacy-collage img{object-position:center 22%}
  .legacy-collage .lc-big{grid-column:1 / 3;grid-row:auto;aspect-ratio:16/10}
  .legacy-collage .lc-full{grid-column:1 / 3;aspect-ratio:16/9}
  .legacy-collage .lc-half{aspect-ratio:4/5}
}

/* ========== menu ========== */
.menu{background:var(--surface);color:var(--ink);padding:104px 0 104px}
.menu-head{max-width:760px;margin:0 auto 54px;text-align:center;display:flex;flex-direction:column;align-items:center}
.menu-head .eyebrow{color:var(--red);justify-content:center}
.menu-head .eyebrow::before{background:var(--red);opacity:.8}
.menu-head h2{color:var(--ink);margin-top:14px}
.menu-lead{color:rgba(15,12,11,.6);max-width:56ch;margin:22px auto 0;font-size:1.02rem;line-height:1.6}
.sig-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-bottom:82px}
.sig{margin:0}
.sig-img{aspect-ratio:5/4;overflow:hidden;border-radius:3px;background:#e9e2d5}
.sig-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s var(--ease)}
.sig:hover .sig-img img{transform:scale(1.045)}
.sig-body{padding:18px 2px 0}
.sig-body h3{font-size:1.16rem;font-weight:600;color:var(--ink);display:flex;align-items:baseline;gap:.5em;letter-spacing:.01em}
.sig-body h3 .sig-price{margin-left:auto;color:var(--red);font-weight:600;font-size:1rem}
.sig-body p{color:rgba(15,12,11,.6);font-size:.95rem;margin:8px 0 0;line-height:1.5}
.menu-cats{display:flex;flex-direction:column;gap:58px}
.menu-cat-title{font-size:.82rem;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--ink);
  padding-bottom:14px;border-bottom:1px solid rgba(15,12,11,.16);margin:0 0 28px}
.menu-items{display:grid;grid-template-columns:1fr 1fr;gap:24px 60px}
.mi-top{display:flex;align-items:baseline;gap:8px}
.mi-name{font-weight:600;font-size:1rem;color:var(--ink);letter-spacing:.005em}
.mi-dots{flex:1;border-bottom:1px dotted rgba(15,12,11,.32);transform:translateY(-4px)}
.mi-price{color:var(--red);font-weight:600;font-size:.98rem;white-space:nowrap}
.mi-desc{color:rgba(15,12,11,.55);font-size:.9rem;margin:5px 0 0;line-height:1.5;max-width:46ch}
.menu-foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:22px;
  margin-top:66px;padding-top:32px;border-top:1px solid rgba(15,12,11,.14)}
.menu-note{color:rgba(15,12,11,.5);font-size:.9rem;max-width:52ch;margin:0;line-height:1.55}


/* ========== visit (redesign) ========== */
.visit{background:var(--ink);color:var(--paper);padding:104px 0 106px}
.visit-head{margin-bottom:54px}
.visit-head .eyebrow{color:var(--gold)}
.visit-head h2{color:var(--paper)}
.visit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;padding-bottom:48px;border-bottom:1px solid var(--line)}
.visit-col h4{font-size:.74rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin:0 0 18px}
.visit-col p{color:var(--paper);font-size:1.06rem;line-height:1.85;margin:0 0 18px}
.visit-col .muted{color:var(--paper-faint)}
.visit-col a:not(.link){color:var(--paper);text-decoration:none;transition:color .25s}
.visit-col a:not(.link):hover{color:var(--gold)}
.visit-note{display:flex;justify-content:space-between;align-items:center;gap:34px;flex-wrap:wrap;margin-top:46px}
.visit-note p{color:var(--paper-dim);max-width:54ch;margin:0;font-size:1rem;line-height:1.7}
.visit-cta{display:flex;gap:14px;flex-wrap:wrap}

/* ========== footer (redesign) ========== */
.foot{background:var(--ink-2);color:var(--paper);padding:82px 0 34px}
.foot-top{display:grid;grid-template-columns:1.25fr 2fr;gap:64px;align-items:start;padding-bottom:50px;border-bottom:1px solid var(--line)}
.foot-brand img{width:210px;height:auto;margin-bottom:20px}
.foot-brand p{color:var(--paper-faint);font-size:.92rem;max-width:34ch;margin:0;line-height:1.6}
.foot-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.foot-col h4{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin:0 0 16px;font-weight:600}
.foot-col a,.foot-col span{display:block;color:var(--paper-dim);font-size:.95rem;margin-bottom:11px;transition:color .25s;text-decoration:none}
.foot-col a:hover{color:var(--paper)}
.foot-col .muted{color:var(--paper-faint)}
.foot-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-top:34px;padding-top:0;border-top:none;font-size:12.5px;letter-spacing:.04em;color:var(--paper-faint)}
.foot-bottom .star{color:var(--red)}

/* ========== lower responsive ========== */
@media(max-width:860px){
  .sig-grid{grid-template-columns:1fr;gap:22px;margin-bottom:60px}
  .menu-items{grid-template-columns:1fr;gap:20px}
  .visit-grid{grid-template-columns:1fr;gap:30px}
  .visit-note{flex-direction:column;align-items:flex-start;gap:22px}
  .menu-foot{flex-direction:column;align-items:flex-start}
  .foot-top{grid-template-columns:1fr;gap:38px}
  .foot-cols{grid-template-columns:1fr 1fr;gap:30px}
}
@media(max-width:520px){ .foot-cols{grid-template-columns:1fr} }

.mobile-menu a.mm-btn{align-self:stretch;justify-content:center;text-align:center;margin-top:30px;font-family:"Montserrat",sans-serif;
  font-weight:500;font-size:14px;letter-spacing:.22em;text-transform:uppercase;
  padding:27px 42px;border:1.5px solid var(--gold);color:#F6F1E9;background:transparent}
.mobile-menu a.mm-btn:hover{background:var(--gold);color:#171310;border-color:var(--gold)}

/* ========== popular dishes ========== */
.popular{background:var(--surface);color:var(--ink);padding:104px 0 104px}
.pop-head{max-width:720px;margin:0 auto 56px;text-align:center;display:flex;flex-direction:column;align-items:center}
.pop-head .eyebrow{color:var(--red);justify-content:center}
.pop-head .eyebrow::before{background:var(--red);opacity:.8}
.pop-head h2{color:var(--ink);margin-top:14px}
.pop-lead{color:rgba(15,12,11,.6);max-width:52ch;margin:22px auto 0;font-size:1.02rem;line-height:1.6}
.pop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.pop{margin:0}
.pop-img{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:3px;background:#e9e2d5}
.pop-img picture{display:block;width:100%;height:100%}
.pop-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s var(--ease)}
.pop:hover .pop-img img{transform:scale(1.05)}
.pop-tag{position:absolute;top:15px;left:15px;z-index:2;font-size:10px;font-weight:600;letter-spacing:.15em;
  text-transform:uppercase;background:rgba(15,12,11,.8);color:var(--gold);padding:8px 13px;border-radius:2px}
.pop-body{padding:22px 2px 0}
.pop-body h3{font-size:1.22rem;font-weight:600;color:var(--ink);display:flex;align-items:baseline;gap:.5em;letter-spacing:.01em}
.pop-body h3 .pop-price{margin-left:auto;color:var(--red);font-weight:600;font-size:1.02rem}
.pop-why{color:rgba(15,12,11,.62);font-size:.96rem;margin:11px 0 0;line-height:1.6}
.pop-more{margin-top:78px;padding-top:46px;border-top:1px solid rgba(15,12,11,.14)}
.pop-more h4{font-size:.74rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--red);text-align:center;margin:0 0 32px}
.pop-more-list{display:grid;grid-template-columns:1fr 1fr;gap:18px 64px;max-width:860px;margin:0 auto}
.pm{display:flex;align-items:baseline;gap:10px}
.pm-name{font-weight:500;color:var(--ink);font-size:1.02rem;letter-spacing:.005em}
.pm-dots{flex:1;border-bottom:1px dotted rgba(15,12,11,.3);transform:translateY(-4px)}
.pm-price{color:var(--red);font-weight:600;font-size:.98rem;white-space:nowrap}
.pop-cta{margin-top:66px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px}
.pop-note{color:rgba(15,12,11,.5);font-size:.9rem;margin:0}
@media(max-width:860px){
  .pop-grid{grid-template-columns:1fr;gap:26px}
  .pop-img{aspect-ratio:16/11}
  .pop-more-list{grid-template-columns:1fr;gap:15px}
}
.popular .btn{color:var(--ink)}

/* ========== news & reviews ========== */
.news{position:relative;color:var(--paper);padding:104px 0 108px;
  background-image:linear-gradient(rgba(10,8,7,.82),rgba(10,8,7,.9)),url('../images/butter-beef-news.jpg');
  background-image:linear-gradient(rgba(10,8,7,.82),rgba(10,8,7,.9)),image-set(url('../images/butter-beef-news.webp') type('image/webp'),url('../images/butter-beef-news.jpg') type('image/jpeg'));
  background-position:0% 0%,center;background-size:auto,cover;background-repeat:repeat,no-repeat}
.news-head{margin-bottom:48px;text-align:center;display:flex;flex-direction:column;align-items:center}
.news-head .eyebrow{color:var(--red);justify-content:center}
.news-head h2{color:var(--paper);margin-top:14px}
.news-feature{display:grid;grid-template-columns:1fr 2.2fr;border:1px solid var(--line);border-radius:4px;overflow:hidden;color:inherit;background:rgba(13,10,9,.5);transition:border-color .3s}
.news-feature:hover{border-color:var(--gold)}
.nf-side{background:linear-gradient(155deg,#C5302A 0%,#8E211C 100%);padding:38px 36px;display:flex;flex-direction:column;justify-content:space-between;gap:40px;min-height:236px}
.nf-label{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.85)}
.nf-meta{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#fff;line-height:1.8}
.nf-main{padding:46px 50px;display:flex;flex-direction:column;gap:16px;justify-content:center}
.nf-main h3{font-size:1.7rem;font-weight:300;color:var(--paper);max-width:22ch;line-height:1.18;margin:0}
.nf-main p{color:var(--paper-dim);font-size:1rem;line-height:1.6;max-width:58ch;margin:0}
.news-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}
.nc{border:1px solid var(--line);border-radius:4px;padding:32px 34px;color:inherit;display:flex;flex-direction:column;gap:13px;background:rgba(13,10,9,.55);transition:border-color .3s,background .3s}
.nc:hover{border-color:var(--gold);background:rgba(13,10,9,.72)}
.nc-top{display:flex;justify-content:space-between;align-items:center}
.nc-src{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--red)}
.nc-read{font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--paper-faint)}
.nc:hover .nc-read{color:var(--gold)}
.nc h3{font-size:1.24rem;font-weight:400;color:var(--paper);letter-spacing:.005em;margin:0}
.nc p{color:var(--paper-dim);font-size:.95rem;line-height:1.55;margin:0}
@media(max-width:860px){
  .news-feature{grid-template-columns:1fr}
  .nf-side{min-height:auto;flex-direction:row;align-items:center;gap:20px;padding:22px 26px}
  .nf-main{padding:30px 26px}
  .news-grid{grid-template-columns:1fr}
}

/* iOS hero height + mobile CTA fixes */
@supports (min-height:100svh){ .hero{min-height:100svh} }
@media(max-width:700px){
  .hero{min-height:86svh}
  .hero-inner{padding-top:40px;padding-bottom:46px}
  .hero-cta{width:100%}
  .hero-cta .btn{width:100%}
}
.burger.open span{background:transparent}
.burger.open span::before{top:0;transform:rotate(45deg)}
.burger.open span::after{top:0;transform:rotate(-45deg)}
